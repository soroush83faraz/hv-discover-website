# hvdiscover.com: server configuration for the static Astro build.
# Apache 2.4 (DirectAdmin); LiteSpeed reads the same file.
#
# The source is site/public/.htaccess, a TEMPLATE: `npm run build` copies it to dist/.htaccess
# and scripts/csp-hashes.mjs writes the sha256 of the pages' inline script into the
# Content-Security-Policy there (placeholders __INLINE_SCRIPT_HASHES__ / __INLINE_STYLE_HASHES__).
# Upload dist/.htaccess together with the pages of the same build, never site/public/.htaccess.
#
# Only directives that DirectAdmin's default AllowOverride (AuthConfig FileInfo Indexes Limit
# Options=...) accepts in .htaccess. mod_rewrite, mod_headers and mod_setenvif are required and
# deliberately not wrapped in <IfModule>: without them the site must fail loudly (500) instead of
# running without its HTTPS redirect and security headers. Optional modules are wrapped.
#
# Checked by tools/test_htaccess_rules.py (it parses section 6 and evaluates every old URL).
#
#   1. Basics      2. Types and compression      3. Security headers
#   4. Caching     5. Access rules               6. URL rules

# ------------------------------------------------------------------ 1. Basics
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
# The site's own error page, with the real status code.
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ------------------------------------------------------------------ 2. Types and compression
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/pdf .pdf
  AddCharset utf-8 .css .js .mjs .json .svg .xml .txt .webmanifest
</IfModule>

# Text only: JPEG, WebP, AVIF and WOFF2 are compressed already. Brotli first where the host has
# it; mod_deflate skips a response that is already encoded.
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
  </IfModule>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
  </IfModule>
</IfModule>

# ------------------------------------------------------------------ 3. Security headers
# The form API (/api/) sends its own Content-Security-Policy, X-Frame-Options, Referrer-Policy,
# X-Content-Type-Options and Cache-Control (api/lib/http.php). "Header always set" would replace
# them (PHP-FPM headers sit in the same table), so the page headers skip /api/.
SetEnvIf Request_URI "^/api/" HVD_API

# Every response, the API included. One year; no includeSubDomains and no preload yet (README).
Header always set Strict-Transport-Security "max-age=31536000"

# Pages and static files. The policy is explained in the README ("Content-Security-Policy").
Header always set Content-Security-Policy "default-src 'none'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' __INLINE_STYLE_HASHES__; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" env=!HVD_API
Header always set X-Frame-Options "DENY" env=!HVD_API
Header always set X-Content-Type-Options "nosniff" env=!HVD_API
# Not "no-referrer": form posts must keep their Origin header, or the API refuses them (403).
Header always set Referrer-Policy "strict-origin-when-cross-origin" env=!HVD_API
Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()" env=!HVD_API
Header always set Cross-Origin-Opener-Policy "same-origin" env=!HVD_API

# ------------------------------------------------------------------ 4. Caching
# /_astro/ holds the build's hashed files (CSS, JS, images, fonts): every build gives a changed
# file a new name, so they never need revalidating.
SetEnvIf Request_URI "^/_astro/" HVD_ASSET
# Pages, sitemaps and robots.txt: revalidate every time (ETag), so an upload shows at once.
<FilesMatch "\.(?:html|xml|txt)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(?:css|js|mjs)$">
  Header set Cache-Control "no-cache"
  Header set Cache-Control "public, max-age=31536000, immutable" env=HVD_ASSET
</FilesMatch>
# Images and fonts outside /_astro/ (favicon.svg): 30 days.
<FilesMatch "\.(?:avif|webp|jpe?g|png|gif|svg|ico|woff2?)$">
  Header set Cache-Control "public, max-age=2592000"
  Header set Cache-Control "public, max-age=31536000, immutable" env=HVD_ASSET
</FilesMatch>
# Datasheets keep their names when a new edition is uploaded: one day.
<FilesMatch "\.pdf$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>
# The API is never cached (it says so itself; this covers responses Apache generates there).
Header always set Cache-Control "no-store, max-age=0" env=HVD_API

# ------------------------------------------------------------------ 5. Access rules
# Dotfiles (.htaccess, .user.ini, .env ...) and source, backup and archive files that never
# belong on the server: 403 with the site's error page. Dot-folders (.git/) are refused by
# path in 6.2. Remove an extension here before publishing such a file on purpose.
<FilesMatch "^\.|\.(?:md|map|sql|bak|orig|old|swp|log|sh|ini|zip|tar|gz|tgz|7z|rar)$|^package(?:-lock)?\.json$|~$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# The WordPress copy kept for rollback (README "Deploy and rollback"): refused entirely.
# RedirectMatch rules merge into sub-folders even when that copy brings its own .htaccess with
# rewrite rules, which would otherwise switch off the rewrite rule in 6.2 for it.
RedirectMatch 403 ^/_wp-rollback(?:/|$)

# ------------------------------------------------------------------ 6. URL rules
# Per-directory mod_rewrite, top to bottom; patterns see the path without its leading slash.
RewriteEngine On

# 6.0 Internal redirects (the clean-URL rewrite of 6.10, ErrorDocument pages) are served as they
#     are: every rule below applies to the client's own request only. Without this, the error page
#     for a request refused over http:// or www. would itself be redirected by 6.7.
RewriteCond %{ENV:REDIRECT_STATUS} .
RewriteRule ^ - [L]

# 6.1 Let's Encrypt HTTP-01 validation: never redirected, never rewritten.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# 6.2 Never served: dot-folders and dotfiles (except /.well-known/), the WordPress rollback copy.
RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F]
RewriteRule ^_wp-rollback(?:/|$) - [F]

# 6.3 Other hosts whose folder sits inside public_html (DirectAdmin subdomains such as
#     blog.hvdiscover.com -> public_html/blog/) are not this site: leave them alone.
RewriteCond %{HTTP_HOST} ^(?!www\.)[^.]+\.hvdiscover\.com\.?(?::\d+)?$ [NC]
RewriteRule ^ - [L]

# 6.4 WordPress login, admin, XML-RPC, REST API and core folders (also behind /index.php/ and the
#     old /en/ login route), and the ?author= user-enumeration probe: plain 404, no redirect, so
#     scanners get nothing.
RewriteRule ^(?:(?:index\.php|en)/)?(?:wp-login\.php|xmlrpc\.php|wp-admin(?:/.*)?|wp-json(?:/.*)?|wp-(?:content|includes)/.*)$ - [R=404,L,NC]
RewriteCond %{QUERY_STRING} (?:^|&)author= [NC]
RewriteRule ^(?:index\.php/?)?$ - [R=404,L]

# 6.5 Old WordPress URLs: docs/03-redirect-map.md (final paths from docs/05-decisions.md) and
#     content/urls.csv. Targets are absolute, so an old http:// or www. link reaches its new page in
#     one hop; the trailing "?" drops the old query string. Each pattern accepts the /index.php/
#     prefix of the old PATH_INFO permalinks; 6.5d strips that prefix from every other URL. A new
#     page that reuses an old slug (blog, shop, stores, product ...) must have its rule removed here.

# 6.5a Query-string URLs on / and /index.php, by wp_posts ID (?p= also reached pages and products).
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=(?:2025|12|108|118)(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=116(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/about? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=29(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/contact? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=3(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/privacy? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=1[01](?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/request-a-quote? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=(?:13|52)(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/support? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=10627(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/products? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)p=1524(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/products/pg-10-surge-generator? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)p=1529(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/products/tdr-901-time-domain-reflectometer? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)p=1567(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/products/pg-32-surge-generator? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)p=9708(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/products/ap-01-acoustic-pinpointer? [R=301,L]
# The 12 real image attachments -> /. Every other attachment (247 demo ones), the demo posts, the
# blog page and unknown IDs, search, feeds and archives: gone.
RewriteCond %{QUERY_STRING} (?:^|&)attachment_id=(?:10631|1064[7-9]|1065[0-4]|10989|10991|10993)(?:&|$)
RewriteRule ^(?:index\.php/?)?$ https://hvdiscover.com/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id|attachment_id|s|feed|cat|tag|m)= [NC]
RewriteRule ^(?:index\.php/?)?$ - [G]

# 6.5b Paths -> new pages.
RewriteRule ^(?:index\.php/?|(?:index\.php/)?home/?)$ https://hvdiscover.com/? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?aboutus/?$ https://hvdiscover.com/about? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:contacts-us|our-contacts|stores|emeryville-store)/?$ https://hvdiscover.com/contact? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:shop|product-category/hv-discover)/?$ https://hvdiscover.com/products? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:product/(?:cable-fault-locator-10-kv-pg10|amd-ryzen-5-5600x)|product-category/cable-fault-locator-10-kv-pg10)/?$ https://hvdiscover.com/products/pg-10-surge-generator? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:product/(?:cable-fault-locator-32-kv-pg32|ailink-aluminium-connector|cable-fault-locator-32kv)|product-category/cable-fault-locator-32-kv-pg32)/?$ https://hvdiscover.com/products/pg-32-surge-generator? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?product/(?:time-domain-reflectometer-tdr|amd-ryzen-5-7600x|cable-fault-tdr)/?$ https://hvdiscover.com/products/tdr-901-time-domain-reflectometer? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?product/(?:electro-acoustic-cable-fault-pinpointer|apple-iphone-14-plus|cable-fault-electro-acoustic-pinpointer)/?$ https://hvdiscover.com/products/ap-01-acoustic-pinpointer? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:cart|checkout)/?$ https://hvdiscover.com/request-a-quote? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?privacy-policy/?$ https://hvdiscover.com/privacy? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:refund_returns|delivery-return(?:-2)?)/?$ https://hvdiscover.com/support? [R=301,L,NC]
RewriteRule ^(?:index\.php/)?(?:my-account(?:/.*)?|wishlist|compare|author/hvdiscover)/?$ https://hvdiscover.com/? [R=301,L,NC]
# Old theme links /blog and /promotions -> /; the demo blog /index.php/blog/ is gone (6.5c).
RewriteRule ^(?:blog|promotions)/?$ https://hvdiscover.com/? [R=301,L,NC]
# Sitemap names crawlers try.
RewriteRule ^(?:wp-sitemap|sitemap|sitemap_index|sitemaps)\.xml$ https://hvdiscover.com/sitemap-index.xml? [R=301,L,NC]

# 6.5c Gone (410): demo posts and date archives, categories, tags, authors, the demo blog, comments,
#      Woodmart sliders, demo product categories and products, feeds, WordPress/Yoast sub-sitemaps.
RewriteRule ^(?:index\.php/)?(?:20\d\d|category|tag|author|blog|comments|woodmart_slider|product-category|product)(?:/.*)?$ - [G,NC]
RewriteRule ^(?!api/|_astro/)(?:.*/)?feed(?:/[a-z0-9]*)?/?$ - [G,NC]
RewriteRule ^(?:wp-sitemap-.+|[a-z_]+-sitemap\d*)\.xml$ - [G,NC]

# 6.5d Any other /index.php/... URL: the same path without the prefix.
RewriteRule ^index\.php/(.+)$ https://hvdiscover.com/$1 [R=301,L]

# 6.6 No PHP outside /api/ (leftovers of the old site, scanner probes): plain 404.
RewriteRule ^(?!api/)(?:.+/)?[^/]+\.php(?:/.*)?$ - [R=404,L,NC]

# 6.7 HTTPS and the canonical host https://hvdiscover.com (www. and any alias): one 301.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^hvdiscover\.com$ [NC]
RewriteRule ^ https://hvdiscover.com%{REQUEST_URI} [R=301,L]

# 6.8 Build assets and the API are served as they are (api/.htaccess guards the API).
RewriteRule ^(?:_astro|api)(?:/|$) - [L]

# 6.9 One URL per page: /index.html and /index -> /, /about.html -> /about, /about/ -> /about.
#     REDIRECT_STATUS (empty only on the client's own request) and THE_REQUEST (the request
#     line as sent) keep these from firing on the internal rewrites of 6.10 and on error pages.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+index(?:\.html)?[?\s]
RewriteRule ^index(?:\.html)?$ https://hvdiscover.com/ [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+([^?\s]+?)\.html[?\s]
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule \.html$ https://hvdiscover.com/%1 [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/+$ https://hvdiscover.com/$1 [R=301,L]

# 6.10 Clean URLs: real files as they are; /about -> about.html,
#      /products/arm-filter -> products/arm-filter.html. /404 stays a real 404.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(?!404$)(.+)$ /$1.html [L]
