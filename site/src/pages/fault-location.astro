                  <rect class="dg-fill-white" x="100" y="12" width="92" height="32" rx="2"/>
                  <text class="dg-label dg-label--sm" x="146" y="33" text-anchor="middle">ARM Filter</text>
                  <rect class="dg-fill" x="4" y="60" width="82" height="32" rx="2"/>
                  <text class="dg-box-text" x="45" y="81" text-anchor="middle">TDR-901</text>
