          <g class="xs-copper"><circle cx="150.0" cy="170.0" r="9.7"/><circle cx="169.4" cy="170.0" r="9.7"/><circle cx="159.7" cy="186.8" r="9.7"/><circle cx="140.3" cy="186.8" r="9.7"/><circle cx="130.6" cy="170.0" r="9.7"/><circle cx="140.3" cy="153.2" r="9.7"/><circle cx="159.7" cy="153.2" r="9.7"/><circle cx="187.5" cy="180.0" r="9.7"/><circle cx="177.4" cy="197.4" r="9.7"/><circle cx="160.0" cy="207.5" r="9.7"/><circle cx="140.0" cy="207.5" r="9.7"/><circle cx="122.6" cy="197.4" r="9.7"/><circle cx="112.5" cy="180.0" r="9.7"/><circle cx="112.5" cy="160.0" r="9.7"/><circle cx="122.6" cy="142.6" r="9.7"/><circle cx="140.0" cy="132.5" r="9.7"/><circle cx="160.0" cy="132.5" r="9.7"/><circle cx="177.4" cy="142.6" r="9.7"/><circle cx="187.5" cy="160.0" r="9.7"/></g>
          <path class="xs-lead" d="M212.9 51.7L322 35H332"/><circle class="xs-dot" cx="212.9" cy="51.7" r="3"/><text class="dg-label" x="338" y="40">Outer sheath</text>
          <path class="xs-lead" d="M240.7 88.4L322 89H332"/><circle class="xs-dot" cx="240.7" cy="88.4" r="3"/><text class="dg-label" x="338" y="94">Metallic screen</text>
          <path class="xs-lead" d="M255.2 131.7L322 143H332"/><circle class="xs-dot" cx="255.2" cy="131.7" r="3"/><text class="dg-label" x="338" y="148">Insulation screen</text>
          <path class="xs-lead" d="M231.8 175.7L322 197H332"/><circle class="xs-dot" cx="231.8" cy="175.7" r="3"/><text class="dg-label" x="338" y="202">XLPE insulation</text>
          <path class="xs-lead" d="M199.1 189.9L322 251H332"/><circle class="xs-dot" cx="199.1" cy="189.9" r="3"/><text class="dg-label" x="338" y="256">Conductor screen</text>
          <path class="xs-lead" d="M170.5 186.0L322 305H332"/><circle class="xs-dot" cx="170.5" cy="186.0" r="3"/><text class="dg-label" x="338" y="310">Conductor</text>
        </svg>
                <svg class="diagram dg-narrow" viewBox="0 0 360 300" role="img" aria-labelledby="xs-title-n xs-desc">
          <title id="xs-title-n">Cross-section of a single-core XLPE medium-voltage cable</title>
          <circle class="xs-sheath" cx="96" cy="150" r="95"/><circle class="xs-bed" cx="96" cy="150" r="87"/>
          <g class="xs-copper-wire"><circle cx="179.0" cy="150.0" r="2.4"/><circle cx="178.0" cy="163.0" r="2.4"/><circle cx="174.9" cy="175.6" r="2.4"/><circle cx="170.0" cy="187.7" r="2.4"/><circle cx="163.1" cy="198.8" r="2.4"/><circle cx="154.7" cy="208.7" r="2.4"/><circle cx="144.8" cy="217.1" r="2.4"/><circle cx="133.7" cy="224.0" r="2.4"/><circle cx="121.6" cy="228.9" r="2.4"/><circle cx="109.0" cy="232.0" r="2.4"/><circle cx="96.0" cy="233.0" r="2.4"/><circle cx="83.0" cy="232.0" r="2.4"/><circle cx="70.4" cy="228.9" r="2.4"/><circle cx="58.3" cy="224.0" r="2.4"/><circle cx="47.2" cy="217.1" r="2.4"/><circle cx="37.3" cy="208.7" r="2.4"/><circle cx="28.9" cy="198.8" r="2.4"/><circle cx="22.0" cy="187.7" r="2.4"/><circle cx="17.1" cy="175.6" r="2.4"/><circle cx="14.0" cy="163.0" r="2.4"/><circle cx="13.0" cy="150.0" r="2.4"/><circle cx="14.0" cy="137.0" r="2.4"/><circle cx="17.1" cy="124.4" r="2.4"/><circle cx="22.0" cy="112.3" r="2.4"/><circle cx="28.9" cy="101.2" r="2.4"/><circle cx="37.3" cy="91.3" r="2.4"/><circle cx="47.2" cy="82.9" r="2.4"/><circle cx="58.3" cy="76.0" r="2.4"/><circle cx="70.4" cy="71.1" r="2.4"/><circle cx="83.0" cy="68.0" r="2.4"/><circle cx="96.0" cy="67.0" r="2.4"/><circle cx="109.0" cy="68.0" r="2.4"/><circle cx="121.6" cy="71.1" r="2.4"/><circle cx="133.7" cy="76.0" r="2.4"/><circle cx="144.8" cy="82.9" r="2.4"/><circle cx="154.7" cy="91.3" r="2.4"/><circle cx="163.1" cy="101.2" r="2.4"/><circle cx="170.0" cy="112.3" r="2.4"/><circle cx="174.9" cy="124.4" r="2.4"/><circle cx="178.0" cy="137.0" r="2.4"/></g>
          <circle class="xs-semicon" cx="96" cy="150" r="79"/><circle class="xs-xlpe" cx="96" cy="150" r="73.5"/><circle class="xs-semicon" cx="96" cy="150" r="38"/>
          <g class="xs-copper"><circle cx="96.0" cy="150.0" r="6.6"/><circle cx="109.2" cy="150.0" r="6.6"/><circle cx="102.6" cy="161.4" r="6.6"/><circle cx="89.4" cy="161.4" r="6.6"/><circle cx="82.8" cy="150.0" r="6.6"/><circle cx="89.4" cy="138.6" r="6.6"/><circle cx="102.6" cy="138.6" r="6.6"/><circle cx="121.5" cy="156.8" r="6.6"/><circle cx="114.7" cy="168.7" r="6.6"/><circle cx="102.8" cy="175.5" r="6.6"/><circle cx="89.2" cy="175.5" r="6.6"/><circle cx="77.3" cy="168.7" r="6.6"/><circle cx="70.5" cy="156.8" r="6.6"/><circle cx="70.5" cy="143.2" r="6.6"/><circle cx="77.3" cy="131.3" r="6.6"/><circle cx="89.2" cy="124.5" r="6.6"/><circle cx="102.8" cy="124.5" r="6.6"/><circle cx="114.7" cy="131.3" r="6.6"/><circle cx="121.5" cy="143.2" r="6.6"/></g>
          <path class="xs-lead" d="M138.7 69.7L198 25H202"/><circle class="xs-dot" cx="138.7" cy="69.7" r="2.5"/><text class="dg-label dg-label--sm" x="206" y="30">Outer sheath</text><path class="xs-lead" d="M157.7 94.5L198 73H202"/><circle class="xs-dot" cx="157.7" cy="94.5" r="2.5"/><text class="dg-label dg-label--sm" x="206" y="78">Metallic screen</text><path class="xs-lead" d="M167.4 124.0L198 121H202"/><circle class="xs-dot" cx="167.4" cy="124.0" r="2.5"/><text class="dg-label dg-label--sm" x="206" y="126">Insulation screen</text><path class="xs-lead" d="M151.9 153.9L198 169H202"/><circle class="xs-dot" cx="151.9" cy="153.9" r="2.5"/><text class="dg-label dg-label--sm" x="206" y="174">XLPE insulation</text><path class="xs-lead" d="M129.4 163.5L198 217H202"/><circle class="xs-dot" cx="129.4" cy="163.5" r="2.5"/><text class="dg-label dg-label--sm" x="206" y="222">Conductor screen</text><path class="xs-lead" d="M110.2 161.1L198 265H202"/><circle class="xs-dot" cx="110.2" cy="161.1" r="2.5"/><text class="dg-label dg-label--sm" x="206" y="270">Conductor</text>
        </svg>
        <figcaption class="figure-caption">Single-core XLPE cable, schematic. Layer thicknesses are drawn for legibility, not to scale.</figcaption>
      </figure>
    </div>
  </section>

  <!-- THE FOUR STEPS -->
  <section class="section" id="steps" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="steps-title">Four steps, one sequence</h2>
        <p class="lead">Each step hands a narrower search to the next. Skip one and the next is guessing.</p>
      </div>

      <ol class="method">

        <!-- STEP 1 -->
        <li class="method-step" id="step-1" aria-labelledby="step-1-title">
          <span class="method-step__node" aria-hidden="true"></span>
          <div class="method-step__head">
            <span class="method-step__num" aria-hidden="true">1</span>
            <h2 id="step-1-title"><span class="sr-only">Step 1: </span>Pre-locate: measure the distance</h2>
          </div>
          <div class="method-step__grid">
            <div class="method-step__text">
                <p>A time domain reflectometer (TDR) sends a short low-voltage pulse into the faulty phase and records what comes back. Wherever the cable&rsquo;s impedance changes, part of the pulse reflects: at joints, at the cable end, and at the fault.</p>
                <p>The time to the start of the reflection, multiplied by v/2, is the distance. An open circuit reflects with the same polarity as the pulse; a short circuit reflects inverted. The further the fault, the smaller and wider its reflection, because the cable attenuates and spreads the pulse.</p>
              </div>
            <figure class="method-step__fig">
              <div class="tdr-lab plate" data-tdr-lab>
                <div class="tdr-lab__controls">
                  <div class="field tdr-lab__slider">
                    <label class="field__label" for="fault-pos"><span>Fault position</span> <output for="fault-pos" data-lab-pos>1,280 m</output></label>
                    <input class="range" type="range" id="fault-pos" min="104" max="1896" step="8" value="1280" aria-valuetext="1,280 metres along the cable">
                    <div class="range__scale" aria-hidden="true"><span>0 m</span><span>2,000 m</span></div>
                  </div>
                  <fieldset class="seg">
                    <legend class="field__label">Fault type</legend>
                    <div class="seg__opts">
                      <label class="seg__opt"><input type="radio" name="lab-type" value="open" checked><span>Open</span></label>
                      <label class="seg__opt"><input type="radio" name="lab-type" value="short"><span>Short</span></label>
                    </div>
                  </fieldset>
                </div>
                <div class="tdr-lab__plot" data-lab-plot aria-hidden="true"></div>
                <dl class="keyfigs keyfigs--3 tdr-lab__read">
                  <div><dt>Reflection after</dt><dd><span data-lab-t>16.0</span><span class="unit">&micro;s</span></dd></div>
                  <div><dt>v/2, XLPE, typical</dt><dd>80<span class="unit">m/&micro;s</span></dd></div>
                  <div class="is-result"><dt>Distance to fault</dt><dd><span data-lab-d>1,280</span><span class="unit">m</span></dd></div>
                </dl>
                <p class="tdr-lab__formula" data-lab-formula aria-live="polite">80&nbsp;m/&micro;s &times; 16.0&nbsp;&micro;s = <b>1,280&nbsp;m</b> to an open circuit.</p>
              </div>
              <figcaption class="figure-caption">Move the fault along a 2,000&nbsp;m XLPE cable. Top: the cable, with the pulse going out (solid) and coming back (dashed). Below: the trace the TDR draws. The time axis and the distance axis are the same axis, scaled by v/2.</figcaption>
            </figure>
            <dl class="method-facts">
                <div><dt>What you measure</dt><dd>Round-trip time to the reflection, converted to metres with the cable&rsquo;s v/2.</dd></div>
                <div><dt>Typical pitfall</dt><dd>A wrong v/2. Five per cent off in velocity is five per cent off in distance: 64&nbsp;m on a 1,280&nbsp;m fault.</dd></div>
                <div><dt>Instruments</dt><dd>
                  <ul class="station__products">
                    <li><a href="/products/tdr-901-time-domain-reflectometer"><span class="station__model">TDR-901</span> <span class="station__pname">Time domain reflectometer</span></a></li>
                    <li><a href="/products/arm-filter"><span class="station__model">ARM Filter</span> <span class="station__pname">Arc reflection filter, used in step 2</span></a></li>
                  </ul>
                </dd></div>
              </dl>
          </div>
        </li>

        <!-- STEP 2 -->
        <li class="method-step" id="step-2" aria-labelledby="step-2-title">
          <span class="method-step__node" aria-hidden="true"></span>
          <div class="method-step__head">
            <span class="method-step__num" aria-hidden="true">2</span>
            <h2 id="step-2-title"><span class="sr-only">Step 2: </span>Condition: make the fault visible</h2>
          </div>
          <div class="method-step__grid">
            <div class="method-step__text">
                <p>High-resistance and intermittent faults do not show on a low-voltage trace. A surge generator charges a capacitor to several kilovolts and discharges it into the cable. At the fault the voltage breaks down the weak insulation and an arc forms. While it burns, the arc is close to a short circuit, so for a few milliseconds the fault reflects.</p>
                <p>With the arc reflection method (ARM), a filter couples the TDR to the cable and keeps the high voltage away from it. The TDR records one trace before the surge and one during the arc. Where the two traces part is the fault. When the arc is too short to catch, or on long cables, the impulse current method (ICM) reads the current transients of the discharge instead.</p>
              </div>
            <figure class="method-step__fig">
              <div class="plate">
                <svg class="diagram dg-wide" viewBox="0 0 520 330" role="img" aria-labelledby="arm-title arm-desc">
                  <title id="arm-title">Arc reflection method</title>
                  <desc id="arm-desc">Top: a surge generator feeds the cable through an ARM filter, with the TDR connected to the filter; an arc burns at the fault. Bottom: two TDR traces. The reference trace, taken before the surge, runs flat to the cable end. The trace taken during the arc dips down at the fault. The point where they part marks the fault distance.</desc>
                  <!-- circuit -->
                  <rect class="dg-fill" x="8" y="16" width="92" height="36" rx="2"/>
                  <text class="dg-box-text" x="54" y="39" text-anchor="middle">PG-32</text>
                  <path class="dg-line" d="M100 34H128"/>
                  <rect class="dg-fill-white" x="128" y="16" width="112" height="36" rx="2"/>
                  <text class="dg-label dg-label--sm" x="184" y="39" text-anchor="middle">ARM Filter</text>
                  <rect class="dg-fill" x="8" y="72" width="92" height="36" rx="2"/>
                  <text class="dg-box-text" x="54" y="95" text-anchor="middle">TDR-901</text>
                  <path class="dg-line" d="M100 90H184V52"/>
                  <path class="dg-line-2" d="M240 34H508"/>
                  <path class="dg-grey" d="M240 52H508"/>
                  <text class="dg-text dg-text--sm" x="250" y="24">Cable under test</text>
                  <path class="dg-hot" d="M392 34L386 39L397 43L387 48L393 52"/>
                  <text class="dg-text" x="392" y="76" text-anchor="middle">Arc at the fault</text>
                  <!-- traces -->
                  <path class="dg-dash" d="M20 136H48"/>
                  <text class="dg-text dg-text--sm" x="56" y="141">Before the surge: reference</text>
                  <path class="dg-line-2" d="M268 136H296"/>
