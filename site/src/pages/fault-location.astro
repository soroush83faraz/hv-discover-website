                  <path class="dg-dash" d="M20 210H24C28 210 29 168 33 168S39 214 45 213L49 210H470C474 210 476 180 480 178S490 200 500 205L508 208"/>
                  <path class="dg-line-2" d="M20 210H24C28 210 29 168 33 168S39 214 45 213L49 210H392C396 210 398 262 404 262S414 228 424 222S444 214 460 213H508"/>
                  <path class="dg-hot-dash" d="M392 172V296"/>
                  <circle class="dg-point" cx="392" cy="210" r="5"/>
                  <text class="dg-hot-text" x="384" y="186" text-anchor="end">Traces part here</text>
                  <path class="dg-thin" d="M20 296H508"/>
                  <path class="dg-grey" d="M20 296V302M392 296V302M480 296V302"/>
                  <text class="dg-text" x="20" y="320">0 m</text>
                  <text class="dg-hot-text" x="392" y="320" text-anchor="middle">Fault</text>
                  <text class="dg-text" x="480" y="320" text-anchor="middle">Cable end</text>
                </svg>
                <svg class="diagram dg-narrow" viewBox="0 0 360 330" role="img" aria-labelledby="arm-title-n arm-desc">
                  <title id="arm-title-n">Arc reflection method</title>
                  <rect class="dg-fill" x="4" y="12" width="82" height="32" rx="2"/>
                  <text class="dg-box-text" x="45" y="33" text-anchor="middle">PG-32</text>
