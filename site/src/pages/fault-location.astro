                  <path class="dg-dash" d="M8 210H12C15 210 16 172 19 172S24 214 29 213L32 210H312C315 210 317 182 320 180S328 200 336 205L352 208"/>
                  <path class="dg-line-2" d="M8 210H12C15 210 16 172 19 172S24 214 29 213L32 210H230C233 210 235 258 240 258S248 228 256 222S272 214 286 213H352"/>
                  <path class="dg-hot-dash" d="M230 168V292"/>
                  <circle class="dg-point" cx="230" cy="210" r="5"/>
                  <text class="dg-hot-text" x="222" y="184" text-anchor="end">Traces part here</text>
                  <path class="dg-thin" d="M8 292H352"/>
                  <path class="dg-grey" d="M8 292V298M230 292V298M320 292V298"/>
                  <text class="dg-text" x="8" y="316">0 m</text>
                  <text class="dg-hot-text" x="230" y="316" text-anchor="middle">Fault</text>
