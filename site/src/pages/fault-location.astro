                  <path class="dg-thin" d="M14 158l-8 8M38 158l-8 8M62 158l-8 8M86 158l-8 8M110 158l-8 8M134 158l-8 8M230 158l-8 8M254 158l-8 8M278 158l-8 8M302 158l-8 8M326 158l-8 8M350 158l-8 8"/>
                  <path class="dg-line" d="M6 150H354"/>
