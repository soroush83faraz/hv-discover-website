                  <text class="dg-hot-text" x="296" y="30">Loudest: dig here</text>
                  <path class="dg-thin" d="M16 158l-8 8M40 158l-8 8M64 158l-8 8M88 158l-8 8M112 158l-8 8M136 158l-8 8M160 158l-8 8M184 158l-8 8M208 158l-8 8M232 158l-8 8M328 158l-8 8M352 158l-8 8M376 158l-8 8M400 158l-8 8M424 158l-8 8M448 158l-8 8M496 158l-8 8M520 158l-8 8"/>
