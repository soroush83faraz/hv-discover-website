      <div class="btn-row nf__links">
        <Button href="/">Home</Button>
        <Button variant="secondary" href="/products">Products</Button>
        <Button variant="secondary" href="/contact">Contact</Button>
      </div>
      <p class="nf__more">Looking for the method? <a href="/fault-location">How cable fault location works</a>.</p>
    </div>
  </section>
