---
/**
 * 404: port of design/mockups/404.html (pages-b.css): graticule head with a TDR trace that
 * shows no reflection (wide and narrow SVG variants), and links to Home, Products, Contact.
 * Kept out of the sitemap (astro.config.mjs) and out of search results (noindex).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import '../styles/pages-b.css';
---
<BaseLayout
  title="Page not found | HV Discover"
  description="This page does not exist on hvdiscover.com. Go to the products, the fault location method or the contact page."
  noindex
>
  <section class="hero hero--page nf" aria-labelledby="page-title">
    <div class="wrap hero__inner">
      <p class="nf__code">Error 404</p>
      <h1 class="page-title" id="page-title">No reflection at this address.</h1>
      <p class="page-head__sub">We sent a pulse down this link and nothing came back. The page may have moved when the site was rebuilt, or the address has a typo.</p>

      <figure class="nf__trace">
        <svg class="diagram dg-wide" viewBox="0 0 960 170" role="img" aria-label="A TDR trace: the launch pulse at 0 metres, then a flat line to the end of the range with no reflection.">
          <path class="dg-thin" d="M0 140H952"/>
          <path class="dg-grey" d="M0.5 140V148M238 140V145M476 140V145M714 140V145M951.5 140V148"/>
          <text class="dg-text dg-text--sm" x="0" y="166">0 m</text>
