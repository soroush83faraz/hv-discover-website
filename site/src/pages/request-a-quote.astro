---
/**
 * Request a quote: port of design/mockups/request-a-quote.html (pages-b.css).
 * Left: the quote list (localStorage, rendered by src/scripts/quote.ts from the embedded
 * #quote-catalog), quantities, remove/undo and "Add a product". Right: the quote form.
 * Answers from the Home quote starter prefill the cable voltage and length.
 * With JavaScript the form is sent by fetch (src/scripts/lib/submit.ts, api/CLIENT.md);
 * without it, it posts to /api/quote.php as a normal form and the API takes it from there.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import QuoteCatalog from '../components/QuoteCatalog.astro';
import { breadcrumbs } from '../lib/structured-data';
import '../styles/pages-b.css';

// Digits, spaces and + ( ) . - only. A JS string, because Astro reads backslashes in quoted
// attributes as escapes; the escapes inside the class keep it valid for the browser's
// v-flag pattern parsing as well as for forms.ts.
const PHONE_PATTERN = String.raw`[0-9+\(\)\s.\-]{6,24}`;
---
<BaseLayout
  title="Request a quote | HV Discover"
  description="Send one request for every HV Discover instrument you need: check your quote list, set quantities, tell us about the cable, and we reply by email."
  jsonLd={[breadcrumbs([{ name: 'Request a quote', path: '/request-a-quote' }])]}
>
  <div class="wrap page-head">
    <h1 class="page-title">Request a quote</h1>
    <p class="page-head__sub">Check the products in your list, set quantities and tell us about the cable. One request covers everything, and we reply by email.</p>
  </div>

  <div class="wrap quote-page" data-quote-page>
    <!-- the list -->
    <section class="quote-page__list" aria-labelledby="list-title">
      <div class="qhead">
        <h2 id="list-title">Your quote list</h2>
        <span class="qhead__count" data-qcount>Empty</span>
      </div>
      <ul class="qlist" data-qlist hidden></ul>

      <div class="qempty plate" data-qempty>
        <h3>Nothing in your list yet.</h3>
        <p>Use &ldquo;Add to quote&rdquo; on any product page, or add products below. You can also send the form without products and describe the job in the message.</p>
        <div class="btn-row">
          <Button variant="secondary" href="/products">Browse products</Button>
          <Button variant="secondary" href="/fault-location">Which instruments do I need?</Button>
        </div>
      </div>

      <div class="qadd" data-qadd-wrap>
        <h3 class="qadd__title" id="qadd-title" data-qadd-title>Add a product</h3>
        <ul class="qadd-list" data-qadd aria-labelledby="qadd-title"></ul>
      </div>

      <div class="qstatus form-status" data-qstatus hidden>
        <span data-qstatus-text></span>
        <button type="button" data-qundo>Undo</button>
      </div>
      <div class="qlist-foot" data-qfoot hidden>
        <a class="text-link" href="/products">Browse all products</a>
        <span class="muted">Not sure what you need? Describe the job in the message.</span>
      </div>
      <p class="sr-only" aria-live="polite" data-qlive></p>
    </section>

    <!-- the form -->
    <section class="quote-page__form" aria-labelledby="form-title">
      <h2 class="sr-only" id="form-title">Your details</h2>
      <form class="form-plate plate" id="quote-form" action="/api/quote.php" method="post" novalidate aria-labelledby="form-title">
        <div class="form-status form-alert" data-form-alert hidden>
          <b data-form-alert-title>Check the form.</b> <span data-form-alert-text></span>
        </div>

        <fieldset class="form-group">
          <legend>About you</legend>
          <div class="quote-form__fields">
            <div class="field">
              <label class="field__label" for="q-name">Name</label>
              <input class="input" id="q-name" name="name" type="text" maxlength="100" autocomplete="name" required
                     data-msg-required="Enter your name, so we know who to reply to." aria-describedby="q-name-error">
              <p class="field__error" id="q-name-error" hidden><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5v4.2M7 9.6v.9" stroke="currentColor" stroke-width="1.6"/></svg><span></span></p>
            </div>
            <div class="field">
              <label class="field__label" for="q-company">Company or utility</label>
              <input class="input" id="q-company" name="company" type="text" maxlength="150" autocomplete="organization" required
                     data-msg-required="Enter your company or utility, so we can prepare the offer in its name." aria-describedby="q-company-error">
              <p class="field__error" id="q-company-error" hidden><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5v4.2M7 9.6v.9" stroke="currentColor" stroke-width="1.6"/></svg><span></span></p>
            </div>
            <div class="field">
              <label class="field__label" for="q-country">Country</label>
              <input class="input" id="q-country" name="country" type="text" maxlength="80" autocomplete="country-name" required
                     data-msg-required="Enter the country where the equipment will be used. It decides delivery and power options." aria-describedby="q-country-hint q-country-error">
              <p class="field__hint" id="q-country-hint">Where the equipment will be used.</p>
              <p class="field__error" id="q-country-error" hidden><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5v4.2M7 9.6v.9" stroke="currentColor" stroke-width="1.6"/></svg><span></span></p>
            </div>
            <div class="field">
              <label class="field__label" for="q-email">Email</label>
              <input class="input" id="q-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" required
                     data-msg-required="Enter your email address. The quote is sent there."
                     data-msg-invalid="Enter an email address in the form name@company.com." aria-describedby="q-email-error">
              <p class="field__error" id="q-email-error" hidden><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5v4.2M7 9.6v.9" stroke="currentColor" stroke-width="1.6"/></svg><span></span></p>
            </div>
            <div class="field">
              <label class="field__label" for="q-phone">Phone <span class="field__opt">optional</span></label>
              <input class="input" id="q-phone" name="phone" type="tel" maxlength="24" autocomplete="tel" inputmode="tel"
                     pattern={PHONE_PATTERN}
                     data-msg-invalid="Enter a phone number using digits, spaces and + ( ) - only, including the country code." aria-describedby="q-phone-hint q-phone-error">
              <p class="field__hint" id="q-phone-hint">With country code. Only if you prefer a call back.</p>
              <p class="field__error" id="q-phone-error" hidden><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5v4.2M7 9.6v.9" stroke="currentColor" stroke-width="1.6"/></svg><span></span></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="form-group">
          <legend>About the cable <span class="field__opt">optional</span></legend>
          <div class="quote-form__fields">
            <div class="field">
              <label class="field__label" for="q-voltage">Cable voltage</label>
              <select class="select" id="q-voltage" name="voltage">
                <option value="">Choose a voltage</option>
                <option>Low voltage, up to 1 kV</option>
                <option>6 to 11 kV</option>
                <option>20 kV</option>
                <option>33 to 36 kV</option>
                <option>Above 36 kV</option>
                <option value="unknown">I don&rsquo;t know</option>
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="q-length">Approximate length</label>
              <select class="select" id="q-length" name="length">
                <option value="">Choose a length</option>
                <option>Under 500 m</option>
                <option>500 m to 2 km</option>
                <option>2 to 5 km</option>
                <option>5 to 20 km</option>
                <option>Over 20 km</option>
                <option value="unknown">I don&rsquo;t know</option>
              </select>
            </div>
            <div class="field field--full">
              <label class="field__label" for="q-message">Message</label>
              <textarea class="input textarea" id="q-message" name="message" rows="5" maxlength="5000" aria-describedby="q-message-hint q-message-error"></textarea>
              <p class="field__hint" id="q-message-hint">Fault types you see, cable type, training needs. Required only if your quote list is empty.</p>
              <p class="field__error" id="q-message-error" hidden><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 3.5v4.2M7 9.6v.9" stroke="currentColor" stroke-width="1.6"/></svg><span></span></p>
            </div>
          </div>
        </fieldset>

        <div class="hp-field">
          <label for="q-website">Leave this field empty</label>
          <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="form-foot">
          <p class="quote-form__note">We use these details only to prepare and send your quote. See the <a href="/privacy">privacy notice</a>.</p>
          <Button type="submit">Send quote request</Button>
        </div>
      </form>
    </section>
  </div>
  <QuoteCatalog />
</BaseLayout>

<script>
  import '../scripts/quote';
</script>
