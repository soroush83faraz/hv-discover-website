---
/**
 * Home. The first screen says what we sell and what it does: the job in plain words, what we
 * supply, three real figures and the core instruments as one group (EquipmentGroup). Then the
 * four jobs with an instrument for each (SolutionCards), the dark "Every cable fault has an
 * address" band with the TDR instrument, the cable test van, support and the quote starter.
 * The product tiles live on /products only (Add to quote: product pages and the catalogue).
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TdrInstrument from '../components/TdrInstrument.astro';
import EquipmentGroup from '../components/EquipmentGroup.astro';
import SolutionCards from '../components/SolutionCards.astro';
import QuoteStarter from '../components/QuoteStarter.astro';
import Button from '../components/Button.astro';
import { getProduct } from '../lib/products';
import { COPY } from '../scripts/tdr/scenarios';
import { SITE } from '../data/site';
import vanExterior from '../assets/img/van-exterior.jpg';
import vanInterior from '../assets/img/van-interior.jpg';
import '../styles/home.css';

/** A key figure from a product file (the single source of truth); the build fails if it is gone. */
async function keyFigure(slug: string, label: string): Promise<{ value: string; unit: string }> {
  const f = (await getProduct(slug)).data.keyFigures.find((k) => k.label === label);
  if (!f?.value || !f.unit) throw new Error(`Home: key figure "${label}" missing in ${slug}`);
  return { value: f.value, unit: f.unit };
}
const range = await keyFigure('tdr-901-time-domain-reflectometer', 'Range');
const surge = await keyFigure('pg-32-surge-generator', 'DC output');
const band = await keyFigure('ap-01-acoustic-pinpointer', 'Frequency range');
const facts = [
  { label: 'Range up to', value: range.value, unit: range.unit },
  { label: 'Surge up to', value: surge.value.split('–').pop()!, unit: surge.unit },
  { label: 'Acoustic band', value: band.value.replace('–', ' to '), unit: band.unit },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon.svg', SITE.url).href,
  email: SITE.email,
  // City and country only: the street address in site.ts is a placeholder and stays out of structured data.
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressCountry: SITE.countryCode,
  },
};
---
<BaseLayout
  title="HV Discover: cable fault location instruments"
  description="Instruments that turn a failed underground cable into a distance in metres, then into the exact spot to dig: TDR, surge generators, pinpointer and route tracer."
  jsonLd={[organization]}
>
  <!-- HERO: what we sell and what it does -->
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="wrap home-hero__grid">
      <div class="home-hero__copy">
        <h1 id="hero-title">Find the fault in an underground cable.</h1>
        <p class="home-hero__sub">We supply cable fault location equipment: reflectometers, surge generators, acoustic pinpointers and route tracers, or all of them fitted in one test van.</p>
        <div class="btn-row home-hero__actions">
          <Button href="#quote">Request a quote</Button>
          <Button variant="secondary" href="#how-it-works">See how fault location works</Button>
        </div>
        <ul class="home-hero__facts">
          {facts.map((f) => <li>{f.label} <b><span class="nowrap">{f.value} {f.unit}</span></b></li>)}
        </ul>
      </div>
      <EquipmentGroup />
    </div>
  </section>

  <!-- SOLUTIONS: four jobs, an instrument for each -->
  <section class="section" id="solutions" aria-labelledby="jobs-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="jobs-title">Four jobs, and an instrument for each.</h2>
        <p class="lead">Use one instrument or the whole chain. Add what you need to a quote and we reply by email.</p>
      </div>
      <SolutionCards />
      <p class="jobs__more"><a class="text-link" href="/products">See all instruments in the catalogue</a></p>
    </div>
  </section>

  <!-- PROCESS: the TDR instrument -->
  <section class="section section--dark how" id="how-it-works" aria-labelledby="how-title">
    <div class="wrap how__grid">
      <div class="how__copy">
        <h2 id="how-title">Every cable fault has an address.</h2>
        <p>A reflectometer sends a low-voltage pulse into the cable, and every joint, fault or open end sends part of it back. The time each echo takes to return gives its distance in metres.</p>
        <p class="how__hint" id="tdr-hint">{COPY.hint}</p>
        <a class="text-link" href="/fault-location">The four steps of fault location, in detail</a>
      </div>
      <TdrInstrument />
    </div>
  </section>

  <!-- CABLE TEST VAN -->
  <section class="section section--white van" id="van" aria-labelledby="van-title">
    <div class="wrap">
      <div class="van__top">
        <figure class="van__photo">
          <Picture
            src={vanExterior}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 900px) 66vw, 100vw"
            loading="lazy"
            decoding="async"
            alt="The HV Discover cable test van: a white high-roof van with ‘HV Cable Test Van’ on its side, seen from the front left."
          />
        </figure>
        <div class="van__copy">
          <h2 id="van-title">The whole workflow, on four wheels.</h2>
          <p>The cable test van carries every step of the sequence, fitted and wired: reflectometer, surge generator, acoustic receiver and route tracer, with the high-voltage connections at the rear doors. The crew arrives ready to measure.</p>
          <a class="text-link" href="/cable-test-van">About the cable test van</a>
        </div>
      </div>

      <div class="van__bottom">
        <div class="van__list">
          <h3 class="fitted__title">Fitted equipment</h3>
          <ul class="fitted">
            <li><span class="fitted__step">Step 1</span><span class="fitted__what"><b>Reflectometer</b></span></li>
            <li><span class="fitted__step">Step 2</span><span class="fitted__what"><b>Surge generator</b> <span>with the HV connection panel at the rear doors</span></span></li>
            <li><span class="fitted__step">Step 3</span><span class="fitted__what"><b>Acoustic receiver</b> <span>with headphones</span></span></li>
            <li><span class="fitted__step">Step 4</span><span class="fitted__what"><b>Route tracer</b> <span>transmitter and receiver</span></span></li>
            <li><span class="fitted__step">Cabin</span><span class="fitted__what"><span>Control panel with meters and UPS</span></span></li>
            <li><span class="fitted__step">Rear doors</span><span class="fitted__what"><span>HV connection panel and four cable reels</span></span></li>
          </ul>
        </div>
        <figure class="van__interior">
          <div class="plate">
            <Picture
              src={vanInterior}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 900px) 58vw, 100vw"
              loading="lazy"
              decoding="async"
              alt="Inside the van: an instrument bench with a surge set and two orange instrument cases, a control panel with meters, a UPS, and a pull-out drawer holding a hand-held receiver and headphones."
            />
          </div>
          <figcaption class="figure-caption">Inside: the instrument bench, control panel and UPS, with a pull-out drawer for the hand-held receivers.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- SUPPORT -->
  <section class="section" id="support" aria-labelledby="support-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="support-title">Support that stays with the instrument.</h2>
        <p class="lead">Training, calibration, spare parts and remote help are arranged through support, by model number.</p>
      </div>
      <div class="support-cols">
        <div class="support-col">
          <h3>Training</h3>
          <p>Operator training on each instrument and on the whole sequence, from the first pulse to the dig spot. Ask for it with your quote.</p>
        </div>
        <div class="support-col">
          <h3>Calibration</h3>
          <p>Instruments ship with a calibration certificate. Recalibration and checks are arranged through support.</p>
        </div>
        <div class="support-col">
          <h3>Spare parts</h3>
          <p>Ask for test leads, clamps, earth rods, filters and carrying cases by model number.</p>
        </div>
        <div class="support-col">
          <h3>Remote help</h3>
          <p>Send a screenshot of the trace or a description of the fault. We reply by email.</p>
        </div>
      </div>
      <div class="support__foot small">
        <a class="text-link" href="/support">Support</a>
        <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>

  <!-- QUOTE STARTER -->
  <QuoteStarter />
</BaseLayout>
