---
/**
 * Nameplate tile (design spec 5): a white plate with the product photo (or its line
 * drawing) on a 4:3 canvas, the step label, the model set as a nameplate, the name, the
 * tile figures and "Add to quote". The whole plate is a link target to the product page.
 * The cable test van is not quotable: its tile ends with a plain link to its page instead.
 *   <div class="tiles"> {products.map((p) => <NameplateTile product={p} />)} </div>
 *   <NameplateTile product={van} wide sizes="(min-width: 600px) 50vw, 100vw" />
 */
import { Picture } from 'astro:assets';
import type { Product } from '../lib/products';
import { isQuotable, productHref, tileStep } from '../lib/products';
import PlaceholderDrawing from './PlaceholderDrawing.astro';
import AddToQuote from './AddToQuote.astro';
import Slot from './Slot.astro';

interface Props {
  product: Product;
  /** `sizes` for the photo; match it to the grid the tile sits in. */
  sizes?: string;
  /** tile--wide: spans two columns (the van on Home). */
  wide?: boolean;
  /** tile--row: photo beside the body (catalog families with a single product). */
  row?: boolean;
  /** Eager-load the photo (only for tiles above the fold). */
  eager?: boolean;
}

const {
  product,
  sizes = '(min-width: 1100px) 25vw, (min-width: 600px) 50vw, 100vw',
  wide = false,
  row = false,
  eager = false,
} = Astro.props;
const d = product.data;
const lead = d.images[0];
const href = productHref(product);
const classes = ['tile', wide && 'tile--wide', row && 'tile--row'].filter(Boolean).join(' ');
const rows = d.tileFiguresLayout === 'rows';
---
<article class={classes}>
  <div class="tile__media">
    {
      lead ? (
        <Picture
          src={lead.src}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1600]}
          sizes={sizes}
          alt={d.tileAlt ?? lead.alt}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        d.drawing && <PlaceholderDrawing type={d.drawing} label={d.drawingAlt} />
      )
    }
  </div>
  <div class="tile__body">
    <p class="tile__step">{tileStep(product)}</p>
    <h3 class="tile__model nameplate"><a href={href}>{d.model}</a></h3>
    <p class="tile__name">{d.name}</p>
    <dl class={rows ? 'figs figs--rows' : 'figs'}>
      {
        d.tileFigures.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>
              {f.value}
              {f.unit && (
                <>
                  {' '}
                  <span class="unit">{f.unit}</span>
                </>
              )}
              {f.slot && (
                <>
                  {f.value && ' '}
                  <Slot text={f.slot} />
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="tile__action">
      {
        isQuotable(product) ? (
          <AddToQuote id={d.model} />
        ) : (
          <a class="text-link" href={href}>{`About the ${d.model.toLowerCase()}`}</a>
        )
      }
    </div>
  </div>
</article>
