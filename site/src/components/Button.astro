---
/**
 * Button or link styled as a button. Renders <a> when `href` is given, else <button>.
 *   <Button href="/request-a-quote">Request a quote</Button>
 *   <Button variant="secondary" size="sm" type="button">Remove</Button>
 * Extra attributes (data-*, aria-*) pass through.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  block?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'type' | 'class' | 'href'>;

const { href, variant = 'primary', size = 'md', block = false, type = 'button', class: extra, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', block && 'btn--block', extra]
  .filter(Boolean)
  .join(' ');
---
{
  href ? (
    <a class={classes} href={href} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
