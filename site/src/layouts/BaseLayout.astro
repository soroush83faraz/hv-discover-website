---
/**
 * Every page renders inside this layout: <head> (title, description, canonical, Open
 * Graph, favicon, font preload, JSON-LD), the skip link, Header, <main id="main"> and
 * Footer. Global CSS (tokens, base, components) and the self-hosted Archivo load here;
 * page-section CSS (pages-a.css / pages-b.css) is imported by the pages that need it.
 *
 *   <BaseLayout title="PG-32 surge generator, 30 kV | HV Discover" description="…">
 *     …page sections…
 *   </BaseLayout>
 */
import { getImage } from 'astro:assets';
import '@fontsource-variable/archivo/wdth.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import defaultOg from '../assets/img/tdr-901.jpg';

interface Props {
  /** Full <title>, unique per page. */
  title: string;
  /** Meta description, unique per page (about 150 characters). */
  description: string;
  /** Path of the canonical URL ("/products/pg-32-surge-generator"); defaults to this page. */
  canonicalPath?: string;
  /** Open Graph image: an imported image from src/assets. Defaults to the van photo. */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  ogType?: 'website' | 'product' | 'article';
  /** Keeps the page out of search results (404, quote-sent). */
  noindex?: boolean;
  /** JSON-LD objects, each rendered as its own <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  ogImage = defaultOg,
  ogImageAlt = 'The HV Discover TDR-901 time domain reflectometer, open in its orange case.',
  ogType = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Clean URL: build.format 'file' may report "/about.html"; the canonical is "/about".
const path = canonicalPath ?? (Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/(.)\/$/, '$1') || '/');
const canonical = new URL(path, Astro.site ?? SITE.url).href;
const og = await getImage({ src: ogImage, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site ?? SITE.url).href;
// Design preview (`npm run build:preview`): never indexed, and a notice bar above the header
// (styled by src/styles/preview.css, which astro.config.mjs adds to the preview build only).
// The production build renders neither (the bar is written with no whitespace before the skip
// link, so the production HTML stays byte for byte as it was).
const preview = import.meta.env.PUBLIC_PREVIEW === '1';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? '')} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    {preview && <aside class="preview-bar" aria-label="Preview notice"><p>Design preview for review. Forms are not connected.</p></aside>}<a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
