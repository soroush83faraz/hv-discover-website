# Dependencies and build output (site/.gitignore lists the same inside site/)
node_modules/
site/dist/
site/.astro/
# Generated by site/scripts/sync-api.mjs from api/ on every build
site/public/api/

# Form API: the real configuration (secret, SMTP password) and runtime data never go in git
api/config.php
api/data/
api/tests/
*.eml

# Local files
*.log
.env
.env.*
.DS_Store
Thumbs.db
